# WedPlan Client Environment Variables

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL (Proxied via Next.js rewrites to avoid CORS)
# Note: On macOS, port 5000 is used by AirPlay Receiver (ControlCenter), so port 5001 is used
API_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:5001/api
